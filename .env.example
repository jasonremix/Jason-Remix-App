# ---------------------------------------------------------------------------
# JASON REMIX — client configuration
#
# Only non-secret values belong in this file. Anything prefixed EXPO_PUBLIC_ is
# compiled into the app bundle and is readable by anyone who installs it.
#
# Copy to `.env` for local development. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# API server base URL. Leave EMPTY to run the app in demo mode.
# Local development against the bundled server:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# A device on the same network needs your machine's LAN address, not localhost.
EXPO_PUBLIC_API_BASE_URL=

# Spotify application client id from https://developer.spotify.com/dashboard.
# This value is public by design — PKCE is what protects the flow.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Forces demo mode even when an API URL is configured. Useful for screenshots.
EXPO_PUBLIC_FORCE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# NEVER put SPOTIFY_CLIENT_SECRET here.
#
# The secret belongs only in the API server's own environment
# (see server/.env.example). The mobile client must never receive it: anything
# in this file ships inside the app bundle.
# ---------------------------------------------------------------------------
