{
  "name": "jason-remix-app",
  "version": "1.0.0",
  "description": "JASON REMIX — THE OFFICIAL EXPERIENCE. Music, Rewards & Community app.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "server": "npm --prefix server run dev",
    "server:install": "npm --prefix server install",
    "server:test": "npm --prefix server test",
    "server:seed": "npm --prefix server run seed",
    "expo-go": "node scripts/expo-go.mjs",
    "expo-go:write": "node scripts/expo-go.mjs --write",
    "tunnel": "expo start --tunnel",
    "eas:check": "node scripts/eas-check.mjs",
    "eas:setup": "eas init && eas update:configure && node scripts/eas-check.mjs",
    "eas:build": "eas build --profile preview --platform android",
    "eas:update": "eas update --branch preview"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.3",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.17",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}
