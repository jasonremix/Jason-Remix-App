# ---------------------------------------------------------------------------
# JASON REMIX — API server configuration
#
# Copy to `server/.env`. This file must never be committed with real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# SQLite database file. Created automatically on first run.
DATABASE_URL=./data/jason-remix.sqlite

# --- Secrets ---------------------------------------------------------------
# Both must be set in production; the server refuses to start without them.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs access tokens.
JWT_SECRET=

# Encrypts Spotify tokens at rest (AES-256-GCM). Must be 32 bytes, hex-encoded.
TOKEN_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Spotify ---------------------------------------------------------------
# From https://developer.spotify.com/dashboard.
#
# The CLIENT ID is also set in the mobile app (EXPO_PUBLIC_SPOTIFY_CLIENT_ID).
# The CLIENT SECRET belongs ONLY here — it must never reach the mobile client.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Networking ------------------------------------------------------------
# Comma-separated allowed origins. Use explicit origins in production.
CORS_ORIGINS=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=240
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=30

# --- Seeding ---------------------------------------------------------------
# Used by `npm run seed` to create the first administrator.
SEED_ADMIN_EMAIL=admin@jasonremix.de
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Outbound email
#
# Registration sends a confirmation link, and confirming it sends a welcome
# message. Set EITHER a Resend API key OR an SMTP host — with neither, the API
# reports plainly that no message was sent instead of implying one arrived.
# ---------------------------------------------------------------------------

# Option A — Resend (https://resend.com). One key, nothing to run.
# The sending domain must be verified in the Resend dashboard.
RESEND_API_KEY=

# Option B — any SMTP server. Port 465 uses implicit TLS, everything else
# negotiates STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From: header. Must be an address you are allowed to send from.
EMAIL_FROM_ADDRESS=noreply@jasonremix.de
EMAIL_FROM_NAME=Jason Remix
EMAIL_REPLY_TO=

# How long a confirmation link stays valid.
EMAIL_VERIFICATION_TTL_SECONDS=86400

# Public base URL of THIS API. It goes into the confirmation link, so it has to
# be reachable from the member's phone — `localhost` only works in a simulator
# on the same machine. For a device on your network use the LAN address, e.g.
#   PUBLIC_BASE_URL=http://192.168.1.42:4000
PUBLIC_BASE_URL=http://localhost:4000

# The app's deep-link scheme, used to offer "open the app" after confirming.
APP_SCHEME=jasonremix
