# ---------------------------------------------------------------------------
# JASON REMIX — API server configuration
#
# Copy to `server/.env`. This file must never be committed with real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# SQLite database file. Created automatically on first run.
DATABASE_URL=./data/jason-remix.sqlite

# --- Secrets ---------------------------------------------------------------
# Both must be set in production; the server refuses to start without them.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs access tokens.
JWT_SECRET=

# Encrypts Spotify tokens at rest (AES-256-GCM). Must be 32 bytes, hex-encoded.
TOKEN_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Spotify ---------------------------------------------------------------
# From https://developer.spotify.com/dashboard.
#
# The CLIENT ID is also set in the mobile app (EXPO_PUBLIC_SPOTIFY_CLIENT_ID).
# The CLIENT SECRET belongs ONLY here — it must never reach the mobile client.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Networking ------------------------------------------------------------
# Comma-separated allowed origins. Use explicit origins in production.
CORS_ORIGINS=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=240
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_MUTATION_MAX=30

# --- Seeding ---------------------------------------------------------------
# Used by `npm run seed` to create the first administrator.
SEED_ADMIN_EMAIL=admin@jasonremix.de
SEED_ADMIN_PASSWORD=
